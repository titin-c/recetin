# Copia este archivo como .env y rellénalo. NUNCA subas .env al repositorio (ya está en .gitignore).

# URL pública de la app (en local, la de next dev).
APP_URL="http://localhost:3000"

# PostgreSQL. En Neon: DATABASE_URL = cadena CON pooler (-pooler en el host); DIRECT_URL = cadena directa (migraciones).
DATABASE_URL="postgresql://recetin:recetin@localhost:5432/recetin"
DIRECT_URL="postgresql://recetin:recetin@localhost:5432/recetin"
# Base de datos SOLO para los tests de integración (distinta de la anterior).
DATABASE_URL_TEST="postgresql://recetin:recetin@localhost:5432/recetin_test"

# Secreto para firmar sesiones y enlaces. Genera uno con:  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Acceso con Google (opcional). Pasos para crearlo en docs/despliegue.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Emails. Producción: RESEND_API_KEY. Local: SMTP_HOST=localhost (Mailpit) o nada (se muestran en la terminal).
EMAIL_FROM="RECETÍN <no-responder@tu-dominio.es>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="1025"
# EMAIL_DRIVER="console"   # fuerza un transporte: resend | smtp | console

# Primer administrador (solo al ejecutar pnpm db:seed).
# ADMIN_EMAIL="tu@email.es"
